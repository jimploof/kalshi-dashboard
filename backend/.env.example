# Backend application configuration
# Copy to backend/.env and fill in values: cp backend/.env.example backend/.env

# Database (uses Docker service name 'postgres')
DATABASE_URL=postgresql+asyncpg://kalshi:changeme@postgres:5432/kalshi_dashboard

# Redis (uses Docker service name 'redis')
REDIS_URL=redis://redis:6379/0

# CORS — JSON array of allowed origins (browser-facing URLs only)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Logging
LOG_LEVEL=INFO

# Kalshi
KALSHI_ENV=demo
KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=e6389134-65ae-4986-9d5c-e0805bb99ee5
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi/kalshi.key
KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2
