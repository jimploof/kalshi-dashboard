# Backend application configuration
# Copy to backend/.env and fill in values: cp backend/.env.example backend/.env

# Database (uses Docker service name 'postgres')
DATABASE_URL=postgresql+asyncpg://kalshi:changeme@postgres:5432/kalshi_dashboard

# Redis (uses Docker service name 'redis')
REDIS_URL=redis://redis:6379/0

# CORS — JSON array of allowed origins (browser-facing URLs only)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Logging
LOG_LEVEL=INFO

# Kalshi
KALSHI_ENV=demo
KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=e6389134-65ae-4986-9d5c-e0805bb99ee5
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi/kalshi.key
KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

# Background hydration intervals (seconds)
# Series don't change often — 15 min is a reasonable default.
# Events + markets refresh more frequently — 5 min default.
HYDRATION_INTERVAL_SERIES_SECONDS=900
HYDRATION_INTERVAL_EVENTS_SECONDS=300

# Kalshi REST rate limit (calls per second).
# Set to half the documented cap to leave headroom for route-triggered calls.
# Free/demo tier cap is 20 req/s → default 10 req/s.
KALSHI_REST_MAX_CALLS_PER_SECOND=10

# Debug panel — set to true to expose /api/debug/status and the frontend
# debug button in the footer.  Never enable on a public-facing deployment.
DEBUG_MODE=true
